{
	"name": "easygfx",
	"module": "src/index.ts",
	"type": "module",
	"scripts": {
		"dev": "bun run dev-server.ts",
		"start": "bun run src/index.ts",
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --minify --sourcemap=linked --target browser",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"check:unsafe": "bunx --bun @biomejs/biome check --write --unsafe ./src",
		"typecheck": "tsc --noEmit",
		"docs:dev": "typedoc && bun run docs/sync-docs-assets.ts && vitepress dev docs",
		"docs:build": "bun run build && typedoc && bun run docs/sync-docs-assets.ts && vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "^1.4.0",
		"@webgpu/types": "^0.1.72",
		"documentation": "^14.0.3",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.3",
		"vitepress": "^1.6.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {}
}
